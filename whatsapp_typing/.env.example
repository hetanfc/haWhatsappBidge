# Copia in .env e compila (usato solo da docker compose)
WT_PHONE=393331234567
WT_NAME=Contatto
# Il TUO numero: se compilato, l'accoppiamento avviene con un codice di 8 caratteri
# invece del QR code (molto piu' comodo nei log). Lascia vuoto per usare il QR.
WT_PAIR_PHONE=

# Quanto tempo tenere ON senza nessun refresh da WhatsApp (secondi)
WT_COMPOSING_TIMEOUT=20
# Tolleranza dopo un "paused" prima di spegnere il sensore (secondi, 0 = subito)
WT_OFF_DELAY=3
# false = non ti dichiari online (ma gli eventi di typing potrebbero non arrivare)
WT_MARK_ONLINE=true
WT_LOG_LEVEL=info

MQTT_HOST=192.168.1.10
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=

TZ=Europe/Rome
